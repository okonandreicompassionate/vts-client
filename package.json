{
  "name": "vms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev:user": "pnpm --filter @zora/user dev",
    "dev:admin": "pnpm --filter @zora/admin dev",
    "build": "pnpm -r --if-present run build",
