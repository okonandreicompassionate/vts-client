# Base URL of the vts-server API.
# - Production (Vercel): /api  — vercel.json proxies /api/* to the Render server,
#   so cookies stay first-party.
# - Local development: http://localhost:4000
VITE_API_URL=http://localhost:4000

# Microsoft Entra (Azure AD) app used for "Sign in with Microsoft".
# Defaults (when unset): the Zoracom app registration and the zoracom.com directory.
# For sign-in from any organization's directory, use
#   VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/organizations
# and make the app registration multi-tenant. Register the site origin
# (e.g. https://your-app.vercel.app) as a SPA redirect URI.
VITE_MSAL_CLIENT_ID=
VITE_MSAL_AUTHORITY=
